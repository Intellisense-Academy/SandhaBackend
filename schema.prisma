// schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "./src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  name        String
  phoneNumber String   @unique
  password    String
  role        String
  tenant      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users") // table name = users
}

model Contributor {
  id            String        @id @default(uuid())
  name          String
  mobile        String        @unique
  amount        Float         @default(0)
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("contributors")
}

model Transaction {
  id            String   @id @default(uuid())
  contributorId String
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  amount        Float
  phoneNumber   String   // Can be different from contributor's stored number
  paymentMethod String   @default("cash") // cash, bank transfer, upi, etc.
  status        String   @default("completed") // completed, pending, failed
  month         String   // YYYY-MM format for filtering
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([contributorId])
  @@index([createdAt])
  @@index([month])
  @@index([status])
  @@map("transactions")
}
